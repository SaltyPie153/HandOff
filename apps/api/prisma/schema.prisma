generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model BootstrapProbe {
  id        String   @id @db.Uuid
  value     String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("bootstrap_probes")
}

enum MemberStatus {
  PENDING
  APPROVED
}

enum IdentityProvider {
  GOOGLE
  DISCORD
}

enum AttemptIntent {
  LOGIN
  LINK
}

enum ProjectRole {
  MANAGER
  MEMBER
}

enum ProjectMemberAction {
  ADD
  REMOVE
}

enum HandoffReplySource {
  HUMAN
  CODEX_AUTO
}

enum HandoffVersionStatus {
  AWAITING_REVIEW
  ACKNOWLEDGED
  CHANGES_REQUESTED
  SUPERSEDED
}

enum HandoffResponseAction {
  ACKNOWLEDGE
  REQUEST_CHANGES
}

enum HandoffNotificationKind {
  REQUEST_RECEIVED
  REVISION_RECEIVED
  ACKNOWLEDGED
  CHANGES_REQUESTED
}

enum HandoffJobStatus {
  PENDING
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
}

enum EvidenceKind {
  LOCAL
  GITHUB
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  status         MemberStatus @default(PENDING)
  isServiceAdmin Boolean      @default(false) @map("is_service_admin")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  identities     ProviderIdentity[]
  sessions       AuthSession[]
  oauthAttempts  OAuthAttempt[]
  approvals      MembershipApproval[] @relation("ApprovedUser")
  approvalsMade  MembershipApproval[] @relation("ApprovalActor")
  grants         AdminGrant[] @relation("GrantedUser")
  grantsMade     AdminGrant[] @relation("GrantActor")
  createdProjects Project[] @relation("ProjectCreator")
  projectMemberships ProjectMembership[]
  projectMemberEventsTarget ProjectMemberEvent[] @relation("ProjectEventTarget")
  projectMemberEventsActor ProjectMemberEvent[] @relation("ProjectEventActor")
  sentHandoffs HandoffRequest[] @relation("HandoffSender")
  receivedHandoffs HandoffRequest[] @relation("HandoffRecipient")
  handoffReplies HandoffReply[]
  mcpGrants McpGrant[]
  // Requests already sent remain in the audit trail when their grant is revoked.
  evidenceSources EvidenceSource[]
  handoffResponses HandoffResponse[]
  handoffNotifications HandoffNotification[]

  @@map("users")
}

model Project {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(120)
  description String? @db.VarChar(500)
  creatorId   String @map("creator_id") @db.Uuid
  creator     User @relation("ProjectCreator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships ProjectMembership[]
  memberEvents ProjectMemberEvent[]
  handoffRequests HandoffRequest[]
  mcpGrants McpGrant[]
  evidenceSources EvidenceSource[]

  @@map("projects")
}

model ProjectMembership {
  projectId String @map("project_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role ProjectRole
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_memberships")
}

model ProjectMemberEvent {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action ProjectMemberAction
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target User @relation("ProjectEventTarget", fields: [targetId], references: [id])
  actor User @relation("ProjectEventActor", fields: [actorId], references: [id])

  @@index([projectId, createdAt])
  @@map("project_member_events")
}

model ProviderIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(255)
  displayName     String?          @map("display_name") @db.VarChar(255)
  email           String?          @db.VarChar(320)
  linkedAt        DateTime         @default(now()) @map("linked_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("provider_identities")
}

model AuthSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  csrfHash  String   @map("csrf_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OAuthAttempt {
  stateHash        String           @id @map("state_hash") @db.Char(64)
  provider         IdentityProvider
  intent           AttemptIntent
  browserSessionId String           @map("browser_session_id") @db.VarChar(64)
  memberId         String?          @map("member_id") @db.Uuid
  member           User?            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  nonce            String?          @db.VarChar(64)
  codeVerifier     String?          @map("code_verifier") @db.VarChar(128)

  @@index([expiresAt])
  @@map("oauth_attempts")
}

model MembershipApproval {
  id         String   @id @default(uuid()) @db.Uuid
  targetId   String   @unique @map("target_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  target     User     @relation("ApprovedUser", fields: [targetId], references: [id])
  actor      User     @relation("ApprovalActor", fields: [actorId], references: [id])
  approvedAt DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)

  @@map("membership_approvals")
}

model AdminGrant {
  id        String   @id @default(uuid()) @db.Uuid
  targetId  String   @unique @map("target_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  target    User     @relation("GrantedUser", fields: [targetId], references: [id])
  actor     User?    @relation("GrantActor", fields: [actorId], references: [id])
  source    String   @db.VarChar(16)
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  @@map("admin_grants")
}

model HandoffRequest {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  grantId String? @map("grant_id") @db.Uuid
  publicTitle String @map("public_title") @db.VarChar(160)
  currentVersion Int @default(1) @map("current_version")
  sendKey String @map("send_key") @db.VarChar(128)
  payloadHash String @map("payload_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender User @relation("HandoffSender", fields: [senderId], references: [id])
  recipient User @relation("HandoffRecipient", fields: [recipientId], references: [id])
  grant McpGrant? @relation(fields: [grantId], references: [id])
  versions HandoffVersion[]
  replies HandoffReply[]
  jobs HandoffJob[]
  responses HandoffResponse[]
  notifications HandoffNotification[]

  @@unique([senderId, sendKey])
  @@index([projectId, createdAt])
  @@index([recipientId, createdAt])
  @@index([grantId])
  @@map("handoff_requests")
}

model HandoffVersion {
  id String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  version Int
  status HandoffVersionStatus @default(AWAITING_REVIEW)
  sendKey String? @map("send_key") @db.VarChar(128)
  payloadHash String? @map("payload_hash") @db.Char(64)
  privateBody String @map("private_body") @db.Text
  verificationClaim String? @map("verification_claim") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  request HandoffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  replies HandoffReply[]
  job HandoffJob?
  responses HandoffResponse[]
  notifications HandoffNotification[]

  @@unique([requestId, version])
  @@unique([id, requestId])
  @@unique([requestId, sendKey])
  @@map("handoff_versions")
}

model HandoffReply {
  id String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  body String @db.Text
  source HandoffReplySource
  replyKey String @map("reply_key") @db.VarChar(128)
  payloadHash String @map("payload_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  request HandoffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version HandoffVersion @relation(fields: [versionId, requestId], references: [id, requestId], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@unique([requestId, actorId, replyKey])
  @@index([requestId, createdAt])
  @@map("handoff_replies")
}

model HandoffJob {
  versionId String @id @map("version_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  status HandoffJobStatus @default(PENDING)
  attempts Int @default(0)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  reviewReason String? @map("review_reason") @db.VarChar(255)
  reviewDraft String? @map("review_draft") @db.Text
  executionId String? @map("execution_id") @db.Uuid
  evidenceRefs Json? @map("evidence_refs") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  request HandoffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version HandoffVersion @relation(fields: [versionId, requestId], references: [id, requestId], onDelete: Cascade)

  @@index([status, leaseUntil])
  @@unique([versionId, requestId])
  @@index([requestId])
  @@map("handoff_jobs")
}

model HandoffResponse {
  id String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action HandoffResponseAction
  comment String? @db.VarChar(10000)
  responseKey String @map("response_key") @db.VarChar(128)
  payloadHash String @map("payload_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  request HandoffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version HandoffVersion @relation(fields: [versionId, requestId], references: [id, requestId], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])
  @@unique([versionId, actorId])
  @@unique([requestId, actorId, responseKey])
  @@map("handoff_responses")
}

model HandoffNotification {
  id String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  kind HandoffNotificationKind
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  request HandoffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version HandoffVersion @relation(fields: [versionId, requestId], references: [id, requestId], onDelete: Cascade)
  recipient User @relation(fields: [recipientId], references: [id])
  @@unique([recipientId, versionId, kind])
  @@index([recipientId, createdAt])
  @@map("handoff_notifications")
}

model McpGrant {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentRequests HandoffRequest[]

  @@index([userId, projectId])
  @@map("mcp_grants")
}

model EvidenceSource {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  kind EvidenceKind
  localPath String? @map("local_path") @db.VarChar(1024)
  githubOwner String? @map("github_owner") @db.VarChar(100)
  githubRepo String? @map("github_repo") @db.VarChar(100)
  githubPath String? @map("github_path") @db.VarChar(1024)
  githubRef String? @map("github_ref") @db.VarChar(255)
  syncTokenHash String? @unique @map("sync_token_hash") @db.Char(64)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id])
  snapshot EvidenceSnapshot?

  @@index([ownerId, projectId])
  @@map("evidence_sources")
}

model EvidenceSnapshot {
  sourceId String @id @map("source_id") @db.Uuid
  encryptedContent String @map("encrypted_content") @db.Text
  contentHash String @map("content_hash") @db.Char(64)
  syncedAt DateTime @map("synced_at") @db.Timestamptz(6)
  dirtyAt DateTime? @map("dirty_at") @db.Timestamptz(6)
  source EvidenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("evidence_snapshots")
}
