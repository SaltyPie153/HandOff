# Run npm run dev:init to generate a local .env with a random password.
# Never commit the generated .env.
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DB_PORT=5432
POSTGRES_USER=handoff
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=handoff_dev
DATABASE_URL=postgresql://handoff:CHANGE_ME@127.0.0.1:5432/handoff_dev
# Add these to the generated .env after creating OAuth apps. Register callbacks on the web origin.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Google: http://127.0.0.1:5173/api/auth/google/callback
# Discord: http://127.0.0.1:5173/api/auth/discord/callback
# Link callbacks use /api/auth/links/google/callback and /api/auth/links/discord/callback.
